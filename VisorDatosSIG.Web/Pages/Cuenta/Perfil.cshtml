@page
@model VisorDatosSIG.Web.Pages.Cuenta.PerfilModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Mi Perfil de Usuario";
    var usuario = HttpContext.Session.GetString("Usuario") ?? "admin";
    var nombre = HttpContext.Session.GetString("Nombre") ?? "Administrador del Sistema";
    var rol = HttpContext.Session.GetString("Rol") ?? "Administrador";
}

<div class="page-content-scroll">
    <div class="container max-w-800">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="fas fa-user-circle text-primary me-2"></i>Perfil de Usuario</h3>
                <p class="text-muted mb-0">Información de su cuenta de acceso y gestión de seguridad.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.MensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-1"></i> @Model.MensajeExito
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-1"></i> @Model.MensajeError
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">
            <!-- DATOS GENERALES -->
            <div class="col-md-5">
                <div class="card shadow-sm border-0 p-4 text-center">
                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex justify-content-center align-items-center" style="width:80px; height:80px; font-size:36px;">
                            <i class="fas fa-user"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">@nombre</h5>
                    <p class="text-muted mb-2"><code>@@@usuario</code></p>
                    <div>
                        <span class="badge bg-primary px-3 py-2">Rol: @rol</span>
                    </div>

                    <hr class="my-3" />

                    <div class="text-start small">
                        <p class="mb-2"><strong>Mecanismo de Seguridad:</strong> PBKDF2 (SHA-256)</p>
                        <p class="mb-2"><strong>Iteraciones de Derivación:</strong> 100,000</p>
                        <p class="mb-0"><strong>Sistema:</strong> VisorDatosSIG 2026</p>
                    </div>
                </div>
            </div>

            <!-- FORMULARIO DE CAMBIO DE CONTRASEÑA -->
            <div class="col-md-7">
                <div class="card shadow-sm border-0 p-4">
                    <h5 class="fw-bold mb-3"><i class="fas fa-key text-primary me-2"></i>Actualizar Contraseña</h5>
                    <form method="post" asp-page-handler="CambiarPassword">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Contraseña Actual</label>
                            <input type="password" class="form-control" asp-for="PasswordActual" required placeholder="Ingrese su contraseña actual" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nueva Contraseña</label>
                            <input type="password" class="form-control" asp-for="NuevoPassword" required minlength="6" placeholder="Mínimo 6 caracteres" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Confirmar Nueva Contraseña</label>
                            <input type="password" class="form-control" asp-for="ConfirmarPassword" required minlength="6" placeholder="Repita la nueva contraseña" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mt-2">
                            <i class="fas fa-save me-1"></i> Guardar Nueva Contraseña
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
